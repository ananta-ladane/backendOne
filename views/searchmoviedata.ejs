<%- include("Header/header") %>
    <div class="main-sm">

        <nav class="sd-nav ">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center ">
                    <div class="di1-dnav">
                        <p><button><i class="bi bi-film"></i></button><span>BookMy<i>Show</i></span></p>
                    </div>

                    <form class=" smn" method="post" action="/sdata">
                        <input type="text" placeholder="search movie name" name="movie" />
                        <button type="submit">search</button>
                    </form>

                </div>
            </div>

        </nav>
        <div class="sm-body">
            <div class="container">



                <div class="row gx-2">
                    
                    <h1 class="text-light">Search show list</h1>
                    <% moviedata.map((movie)=> { %>
                        <div class=" col-md-4 mb-3   ">
                            <div class="card">
                                <div class="card-body">
                                    <p> <img class="w-100" src="<%= movie.Image %>"></p>
                                    <h4 class="card-text">
                                        movie name : <%= movie.Moviename %>
                                    </h4>
                                    <p class="card-text">
                                        <%= movie.Discription %>
                                    </p>
                                    <p class="card-text">Rating: <%= movie.Reting %>
                                    </p>
                                    <p class="card-text">Date: <%= movie.Date %>
                                    </p>
                                    <p class="card-text">Time: <%= movie.Time %>
                                    </p>
                                    <p class="card-text">Duration: <%= movie.Duration %>
                                    </p>

                                    <% movie.theaterInfo.map((theater)=> { %>
                                        <strong>Theater name: <%= theater.theatername %></strong>
                                        <p>
                                            <%= theater.city %>,
                                                <%= theater.state %>,
                                                    <%= theater.country%>
                                        </p>

                                        <% }) %>

                                            <div class="d-flex mt-2">

                                                <form method="post" action="/sitdata">
                                                    <input type="hidden" name="id" value="<%= movie._id%>">
                                                    <button type="submit" class="btn btn-primary">Book now</button>
                                                </form>
                                                <button class=" ms-3 btn btn-secondary">see more</button>
                                            </div>
                                </div>
                            </div>
                        </div>

                        <% }); %>
                </div>
            </div>
        </div>
    </div>

    <%- include("Footer/footer") %>