<%- include("Header/header") %>
    <div class="us-div">
        <div class="container mt-2">
            <div class="us-sub">
                <h2>Sign up here</h2>
                <div class="us-sub1">
                    <p class="if">if you already have an account, please <a href="/showloginform">login</a></p>
                    <form class="container mt-2" action="/getdata" method="POST">
                        <input type="text" placeholder="Enter your Username" name="username" class="form-control my-2">
                        <input type="email" placeholder="Enter youe email" name="email" class=" form-control my-2">
                        <input type="password" placeholder="Enter your Password" name="password"
                            class="form-control my-2">
                        <button type="submit" class="btn btn-primary">Sign in</button>
                    </form>

                    <% if(message){ %>
                        <span class="text-danger">
                            <%= message %>
                        </span>
                        <% } %>

                </div>
            </div>

        </div>
    </div>
    <%- include("Footer/footer") %>