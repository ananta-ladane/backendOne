<%- include("Header/header") %>
    <div class="us-div">
        <div class="container mt-2">
            <div class="us-sub">
                <h2>Theater Login</h2>
                <div class="us-sub1">
                    
                    <form method="post" action="/theaterlogindata" class="container mt-5">
                        <input type="email" name="email" placeholder="Email" class="form-control my-2" />
                        <input type="password" name="password" placeholder="Password" class="form-control my-2" />
                        <button type="submit" class="btn btn-primary">Login</button>
                    </form>

                    <% if(message){ %>
                        <span class="text-danger">
                            <%= message %>
                        </span>
                        <% } %>
                </div>
            </div>

        </div>
    </div>
    <%- include("Footer/footer") %>