<%- include("Header/header")%>
    <div class="container">
        <div class="d-flex justify-content-center align-items-center  mt-5 ">
            <div class="w-75 border  border-info rounded-2 p-3">
                <p>if you hava account plz <a href="/optgenerate">login here</a></p>
                <h1>Sign in here</h1>
                <form class="container" method="post" action="/optgetdata">
                    <input type="text" placeholder="Enter your Firstname & Lastname" name="name"
                        class="form-control my-2" />
                    <input type="email" placeholder="Enter your email" name="email" class="form-control my-2" />
                    <button class="btn btn-primary" type="submit">sign in</button>
                </form>

                <% if(message){%>
                    <p class="text-denger">
                        <%= message%>
                    </p>
                    <% }%>
            </div>
        </div>
    </div>
