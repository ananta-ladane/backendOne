<%- include("Header/header") %>
    <div class="us-div">
        <div class="container mt-5">
            <div class="us-sub">
                <h2>Login Here</h2>
                <div class="us-sub1">
                    <form class="container mt-2" action="/login" method="POST">
                        <input type="email" placeholder="Enter your email" name="email" class="form-control my-2">
                        <input type="password" placeholder="Enter your Password" name="password"
                            class="form-control my-2">
                        <button type="submit" class="btn btn-primary">login</button>
                    </form>

                    <% if(message){ %>
                        <span class="text-danger">
                            <%= message %>
                        </span>
                        <a href="/showform">Sign up instead</a>
                        <% } %>

                            <strong class="if">Forgot <a href="/forgetpass"> Password </a></strong>
                </div>
            </div>
        </div>
    </div>
    <%- include("Footer/footer") %>