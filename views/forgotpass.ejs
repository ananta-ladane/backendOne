<%- include("Header/header") %>
    <div class="containser mt-5">
        <div class="d-flex justify-content-center  w-100">
            <div class="w-75 border border-info rounded-3 p-2 ">
                <h3>forgot pass form</h3>
                <form class="m-2" method="post" action="/forgotpassdata">
                    <input type="text" placeholder="Enter your username" name="name" class="form-control my-2" />
                    <input type="email" placeholder="Enter tour Email" name="email" class="form-control my-2" />
                    <button type="submit" class="btn btn-primary">send email</button>
                </form>
                <% if(message){%>
                    <p class="text-danger"><%= message %></p>
                    <%}%>
            </div>
        </div>
    </div>
    <%- include("Footer/footer") %>