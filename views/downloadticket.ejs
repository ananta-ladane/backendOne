<%- include('Header/header') %>
    <div class="main-twp">
        <nav class="sd-nav ">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center ">
                    <div class="di1-dnav">
                        <p><button><i class="bi bi-film"></i></button><span>BookMy<i>Show</i></span></p>
                    </div>

                    <a href="/logout" class="btn btn-danger text-align-end fw-bold">Logout</a>

                </div>
            </div>

        </nav>
        <div class="dw-bd">
            <div class="container">

                <div class="row">
                    <div class="col-md-7 col-xxl-6 mx-auto">
                        <h4 class="card-title text-light">Download Ticket</h4>
                        <p class="card-text text-light">Your ticket has been booked successfully. Please download your
                            ticket.
                        </p>
                        <div class="card">

                            <div class="card-body ticket-c" id="ticket">
                               

                                <p><b>Moviename:</b> <%= tdata.moviename %>
                                </p>

                                <p><b>Show Time:</b> <%= tdata.time %>
                                </p>
                                <p></p><b>Seats: </b><%= tdata.seats %>
                                </p>
                                <p><b>Total Price:</b> <%= tdata.totalprice %>
                                </p>
                                <p><b>Theater:</b> <%= tdata.theatername %>
                                </p>
                                <p><b>Location:</b> <%= tdata.location %>
                                </p>


                            </div>
                        </div>
                        <div class="mt-2">
                            <button class="btn btn-primary" onclick="printIt()">print Ticket</button>
                            <button class="btn btn-primary" onclick=" downloadPDF()"> download Ticket</button>
                            <a href="/showmovielist" class="btn btn-secondary">back to show list page</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <%- include('Footer/footer') %>