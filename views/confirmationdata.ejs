<%- include("Header/header") %>
    <div class="main-cmt">

        <nav class="sd-nav ">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center ">
                    <div class="di1-dnav">
                        <p><button><i class="bi bi-film"></i></button><span>BookMy<i>Show</i></span></p>
                    </div>

                    <form class=" smn d-none" method="post" action="/sdata">
                        <input type="text" placeholder="search movie name" name="movie" />
                        <button type="submit">search</button>
                    </form>

                </div>
            </div>

        </nav>

        <div class="cmt-bd">
            <div class="container mt-5">
                <h1 class="text-light text-center">Confirmation data</h1>



                <div class="row">


                    <div class="col-md-6 offset-md-3 my-2">
                        <div class="card">
                            <div class="card-body">
                                <h4 class="card-text">
                                    booking_id: <%= seatdata._id%>
                                </h4>
                                <p class="card-text">
                                    Movie-Name: <%= seatdata.moviename %>
                                </p>
                                <p class="card-text">
                                    seatno: <%= seatdata.seats %>
                                </p>
                                <p class="card-text">
                                    showdate: <%= seatdata.sbook%>
                                </p>
                                <p class="card-text">
                                    StartTime: <%= seatdata.time %>
                                </p>
                                <p class="card-text">
                                    Duration: <%= seatdata.duration %>
                                </p>
                                <p class="card-text">
                                    Total Price: <%= seatdata.totalprice %>
                                </p>
                                <p class="card-text">
                                    Theater Name: <%= seatdata.theatername %>
                                </p>
                                <p class="card-text">
                                    Location: <%= seatdata.location %>
                                </p>
                                <div class="d-flex">
                                    <form method="post" action="/paynow/<%=seatdata._id%>">
                                        <input type="hidden" name="id" value="<%=seatdata._id%>">
                                        <button class="btn btn-success" type="submit">Pay now</button>
                                    </form>
                                    <button class="btn btn-secondary ms-2"><a href="http://localhost:3000/sitdata"
                                            class="text-white">Cancel</a></button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <%- include("Footer/footer")%>