<%- include("Header/header") %>
    <% if(did){ %>

        <h1>Movie Detiles</h1>
        <div class="container">
            <div class="row gx-2">
                <% moviedata.map((data)=>{ %>
                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <div class="card-body">

                                <img class="w-100" src="<%= data.Image %>" />
                                <h5 class="card-text">Movie name: <%= data.Moviename %>
                                </h5>
                                <p class="card-text">Discription: <%= data.Discription %>
                                </p>
                                <p class="card-text">Reting: <%= data.Reting %>
                                </p>
                                <p class="card-text">Author: <%= data.Author %>
                                </p>
                                <p class="card-text">Date: <%= data.Date %>
                                </p>
                                <p class="card-text">Time: <%= data.Time %>
                                </p>
                                <p class="card-text">End Time: <%= data.Endtime %>
                                </p>
                                <p class="card-text">Duration: <%= data.Duration %>
                                </p>
                                <p class="card-text">Price: <%= data.Price %>
                                </p>
                                <p class="card-text">Show Date and Time: <%= data.datetime %>
                                </p>
                                <p class="card-text">Status: <%= data.status%>

                                        <P>
                                        <div class="d-flex">
                                            <a class="btn btn-primary me-2" href="/finddata/<%= data._id%>"><i
                                                    class="bi bi-pen"></i></a>
                                            <form method="post" action="/remove/<%= data._id %>">
                                                <input type="hidden" name="id" value="<%= data._id%>" />
                                                <input type="hidden" name="tid" value="<%= data.tid %>" />
                                                <button class="btn btn-danger"><i class="bi bi-trash3"></i></button>
                                            </form>
                                        </div>
                                </P>

                            </div>
                        </div>
                    </div>
                    <% })%>
            </div>
            <% } %>
                <%- include("Footer/footer") %>