<%- include("Header/header")%>
        <% if(did) { %>
                <div class="container mt-2">
                        <h1>This is your profile </h1>
                        <div class="row ">
                                <div class="col-md-4 p-2">
                                        <div class="card">
                                                <div class="card-body">
                                                        <strong>Theater name: <%= tdata.theatername %>
                                                        </strong>
                                                        <p>Email: <%= tdata.email %>
                                                        </p>
                                                        <p>Available seats: <%= tdata.seats %>
                                                        </p>
                                                        <p>Landmark: <%= tdata.landmark %>
                                                        </p>
                                                        <p>City: <%= tdata.city %>
                                                        </p>
                                                        <p>State: <%= tdata.state %>
                                                        </p>
                                                        <p>Country: <%= tdata.country %>
                                                        </p>
                                                        <p><a href="/theateredit/<%= tdata._id %>"
                                                                        class="btn btn-primary"><i
                                                                                class="bi bi-pen"></i></a></p>
                                                </div>
                                        </div>
                                </div>


                        </div>
                </div>
                <% }else{ %>
                        <p>Theater profile not found</p>
                        <% } %>
                                <%- include("Footer/footer")%>