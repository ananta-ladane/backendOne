<%- include("Header/header")%>

    <div class="main-bm">
        <nav class="sd-nav ">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center ">
                    <div class="di1-dnav">
                        <p><button><i class="bi bi-film"></i></button><span>BookMy<i>Show</i></span></p>
                    </div>

                    <form class=" smn" method="post" action="/sdata">
                        <input type="text" placeholder="search movie name" name="movie" />
                        <button type="submit">search</button>
                    </form>

                </div>
            </div>

        </nav>


        <% if(ct < mdatetime) {%>

            <% if(bookseat.length < 1 ) { %>
                <div class="bm-body">
                    <div class="container">
                        <h1 class="all">All seats are open for booking you can choose any of them</h1>
                        <% mdata.map((data)=> { %>
                            <div class=" col-md-12 mb-3 ">
                                <div class="card">
                                    <div class="card-body">
                                        <p> <img class="w-100" src="<%= data.Image %>"></p>
                                        <h4 class="card-text">
                                            movie name : <span id="mname">
                                                <%= data.Moviename %>
                                            </span>
                                        </h4>
                                        <p class="card-text">
                                            <%= data.Discription %>
                                                <%= data.tid %>
                                                    <%= data._id %>

                                        </p>
                                        <p class="card-text">Rating: <%= data.Reting %>
                                        </p>
                                        <p class="card-text">Price: <%= data.Price %>
                                        </p>
                                        <p class="card-text">Date:<span id="mdate">
                                                <%= data.Date %>
                                            </span>
                                        </p>
                                        <p class="card-text">Time: <span id="mtime">
                                                <%= data.Time %>
                                            </span>
                                        </p>
                                        <p class="card-text">Endtime: <span id="endtime">
                                                <%= data.Endtime %>
                                            </span>
                                        </p>
                                        <p class="card-text">Duration: <span id="mduration">
                                                <%= data.Duration %>
                                            </span>
                                        </p>
                                        <p class="card-text">Show date & time: <spna id="datetime">
                                                <%=data.datetime%>
                                            </spna>
                                        </p>
                                        <p>Price: <span id="mprice">
                                                <%= data.Price %>
                                            </span></p>
                                        <p class="card-text">
                                            <% data.theaterdata.map((tdata)=>{ %>
                                                <strong>Theater name: <spna id="tname">
                                                        <%= tdata.theatername %>
                                                    </spna></strong>
                                                <p>
                                                    <spna id="location">
                                                        <%= tdata.city %>,
                                                            <%= tdata.state %>,
                                                                <%= tdata.country %></span>
                                                </p>
                                                <p> seats:<% for(let i=1; i <=Number(tdata.seats); i++) { %>
                                                        <button class="btn btn-secodary border border-black m-1"
                                                            onclick="changeColor(this)">
                                                            <%= i %>
                                                        </button>
                                                        <% } %>
                                                </p>

                                                <% })%>
                                                    <input type="date" id="fdate" class="form-control w-25" />
                                                    <input type="email" id="email" placeholder="Enter the your Email"
                                                        class="form-control w-25" />
                                                    <p class="mt-2"><button class="btn btn-primary"
                                                            onclick="addData(this)" data-app-tid="<%= data.tid %>"
                                                            data-app-mid="<%= data._id %>">save
                                                            seat
                                                        </button>
                                                        <!-- <button class="btn border p-2 border-dark"><a href="/showseatbookdata">Next <i
                                                class="bi bi-arrow-right"></i></a></button> -->
                                                    </p>

                                                    <p>tid:<%= data.tid%>
                                                    </p>
                                                    <p>mid:<%= data._id%>
                                                    </p>
                                    </div>
                                </div>
                            </div>


                            <% })%>

                    </div>
                </div>


                <%}else{%>
                    <div class="bm-body">
                        <div class="container mt-5">
                            <h1 class="all">You can only book the available seats</h1>

                            <!-- <%=bookseat%> -->
                            <% mdata.map((data)=> { %>
                                <div class=" col-md-12 mb-3   ">
                                    <div class="card">
                                        <div class="card-body">
                                            <p> <img class="w-100" src="<%= data.Image %>"></p>
                                            <h4 class="card-text">
                                                movie name : <span id="mname">
                                                    <%= data.Moviename %>
                                                </span>
                                            </h4>
                                            <p class="card-text">
                                                <%= data.Discription %>
                                                    <%= data.tid %>
                                                        <%= data._id %>

                                            </p>
                                            <p class="card-text">Rating: <%= data.Reting %>
                                            </p>
                                            <p class="card-text">Price: <%= data.Price %>
                                            </p>
                                            <p class="card-text">Date:<span id="mdate">
                                                    <%= data.Date %>
                                                </span>
                                            </p>
                                            <p class="card-text">Time: <span id="mtime">
                                                    <%= data.Time %>
                                                </span>
                                            </p>
                                            <p class="card-text">Endtime: <span id="endtime">
                                                    <%= data.Endtime %>
                                                </span>
                                            </p>
                                            <p class="card-text">Duration: <span id="mduration">
                                                    <%= data.Duration %>
                                                </span>
                                            </p>
                                            <p class="card-text">Show date & time: <spna id="datetime">
                                                    <%=data.datetime%>
                                                </spna>
                                            </p>
                                            <p>Price: <span id="mprice">
                                                    <%= data.Price %>
                                                </span></p>
                                            <p class="card-text">
                                                <% data.theaterdata.map((tdata)=>{ %>
                                                    <strong>Theater name: <spna id="tname">
                                                            <%= tdata.theatername %>
                                                        </spna></strong>
                                                    <p>
                                                        <spna id="location">
                                                            <%= tdata.city %>,
                                                                <%= tdata.state %>,
                                                                    <%= tdata.country %></span>
                                                    </p>
                                                    <p> seats:<% for(let i=1; i <=Number(tdata.seats); i++) { %>

                                                            <% if(bookseat.includes(i.toString())){ %>
                                                                <button class="btn btn-danger border border-black m-1"
                                                                    onclick="setAlert()">
                                                                    <%= i %>
                                                                </button>
                                                                <% } else{ %>
                                                                    <button class="btn border border-black m-1"
                                                                        onclick="changeColor(this)">
                                                                        <%= i %>
                                                                    </button>
                                                                    <% }} %>

                                                    </p>

                                                    <% })%>
                                                        <input type="date" id="fdate" class="form-control w-25" />
                                                        <input type="email" id="email"
                                                            placeholder="Enter the your Email"
                                                            class="form-control w-25" />
                                                        <p class="mt-2"><button class="btn btn-primary"
                                                                onclick="addData(this)" data-app-tid="<%= data.tid %>"
                                                                data-app-mid="<%= data._id %>">save
                                                                seat
                                                            </button>
                                                            <!-- <button class="btn border p-2 border-dark"><a href="/showseatbookdata">Next <i
                                                class="bi bi-arrow-right"></i></a></button> -->
                                                        </p>

                                                        <p>tid:<%= data.tid%>
                                                        </p>
                                                        <p>mid:<%= data._id%>
                                                        </p>
                                        </div>
                                    </div>
                                </div>
                                <% })%>

                        </div>
                    </div>
                    <%}%>
                        <%} else{%>

                            <h1 class="somonoa">Sorry, ticket booking for this show is no longer available.</h1>

                            <% } %>
    </div>
    </div>
    <%- include("Footer/footer") %>